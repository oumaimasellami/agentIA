Neo4j Database Configuration (EXAMPLE - Copy to .env and fill with real values)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j2026!

# Server Configuration
SERVER_PORT=5000
SERVER_HOST=localhost

# Python Environment
PYTHONPATH=.#

# -------------------------------------------------------------------
# Azure DevOps extraction (real data)
# -------------------------------------------------------------------
AZURE_ORG=faurecia-cloud
AZURE_PROJECT=MES_X.0
AZURE_PAT=replace_with_real_pat

# -------------------------------------------------------------------
# Webhook auto-refresh for NRT scope
# -------------------------------------------------------------------
# Shared secret checked by /api/webhook/azure-devops endpoint
AZURE_WEBHOOK_TOKEN=replace_with_strong_secret

# true = webhook triggers extraction/rebuild automatically
WEBHOOK_AUTO_REFRESH_ENABLED=true

# backfill = fast update for missing PR/Commit records only
# full     = full extraction pipeline
WEBHOOK_REFRESH_MODE=backfill

# Include strict broker/ingestion extraction phase
WEBHOOK_INCLUDE_STEP3=true
WEBHOOK_AZURE_INSECURE_TLS=true
WEBHOOK_AZURE_DISABLE_ENV_PROXY=true
WEBHOOK_AZURE_MAX_WORKERS=2
WEBHOOK_AZURE_MAX_RETRIES=8
WEBHOOK_AZURE_REQUEST_DELAY_MS=250

# Python interpreter used by webhook worker
NRT_PYTHON_BIN=D:\Python\bin\python.exe
